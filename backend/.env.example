# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=gym_management

# Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (for seed script)
ADMIN_USERNAME=coach
ADMIN_PASSWORD=Coach@Gym2026!

# CORS & Network
FRONTEND_ORIGIN=http://localhost:3000

# Cloudinary (Optional, local storage fallback used if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Storage Directory for Member Photos
UPLOAD_DIR=uploads/profiles

